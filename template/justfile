# Quality gates for @@PLUGIN_NAME@@ (@@PLUGIN_ID@@).
#
# Generated from bitty-plugin-template. The plugin itself is Lua only: the
# host loads `bitty-plugin.toml` and the `lua/` module root, nothing else.
# Every pin lives in this file. The manifest gate runs the authoritative SDK
# linter (bitty-plugin-lint) fetched by commit through `bunx`; the Lua gate
# parses every source with the Lua 5.4 compiler. Extra tooling (formatters,
# Markdown lint, commit hooks, LuaLS, dependency bots) is optional and up to
# the plugin author; none of it is required here.

# Pinned bitty-plugin-sdk commit that provides `bitty-plugin-lint`. Bump it
# deliberately when you move to a newer SDK manifest contract.
sdk_ref := "@@PLUGIN_SDK_REF@@"

# Lua 5.4 compiler used as a parse-only checker (`-p` writes no output).
# Override with `LUAC=/path/to/luac5.4 just check` when your platform names
# the binary differently.
luac := env("LUAC", "luac5.4")

# List available recipes.
default:
    @just --list

# The manifest schema is owned by bitty-docs, not by this repository. The
# first run downloads the pinned SDK into the bunx cache (network required);
# later runs reuse the cache.
# Validate bitty-plugin.toml with the SDK linter pinned by `sdk_ref` (R-SDK-2).
manifest:
    bunx --bun --package github:bitty-terminal/bitty-plugin-sdk#{{ sdk_ref }} bitty-plugin-lint bitty-plugin.toml

# Fails when no source is found, so a moved or emptied module root cannot
# pass silently.
# Parse every Lua source under lua/ with the Lua 5.4 compiler.
lua:
    #!/usr/bin/env sh
    set -eu
    count=$(find lua -type f -name '*.lua' | wc -l | tr -d ' ')
    if [ "$count" -eq 0 ]; then
        echo "lua: no Lua sources under lua/" >&2
        exit 1
    fi
    find lua -type f -name '*.lua' -exec '{{ luac }}' -p {} +
    echo "lua: parsed $count file(s) with {{ luac }}"

# The checker must exist and must reject an invalid snippet, so a missing or
# no-op checker cannot make `just lua` pass.
# Fail-closed control: the Lua checker must reject invalid input.
lua-control:
    #!/usr/bin/env sh
    set -eu
    if ! command -v '{{ luac }}' >/dev/null 2>&1; then
        echo "lua-control: '{{ luac }}' not found; install Lua 5.4" >&2
        exit 1
    fi
    if printf 'local =\n' | '{{ luac }}' -p - 2>/dev/null; then
        echo "lua-control: '{{ luac }}' accepted invalid Lua" >&2
        exit 1
    fi
    echo "lua-control: '{{ luac }}' rejects invalid Lua"

# Aggregate gate run locally and in CI.
check: manifest lua lua-control
